# --- Modelo local (este fork) ---
# URL del servidor Ollama (puede estar en otra máquina de la red)
OLLAMA_BASE_URL=http://localhost:11434
# Solo para la forma string "ollama:modelo" de create_agent
OLLAMA_HOST=http://localhost:11434

# --- Búsqueda web (requerida para web_search / personal chef) ---
TAVILY_API_KEY='****'

# --- LangSmith (tracing, opcional pero recomendado) ---
LANGSMITH_API_KEY='****'
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=lca-lc-foundations

# --- Proveedores de pago del curso original (NO necesarios en este fork) ---
# OPENAI_API_KEY='****'
# ANTHROPIC_API_KEY='****'
# GOOGLE_API_KEY='****'
